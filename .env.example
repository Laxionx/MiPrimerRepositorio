# Trading Bot Configuration - Analysis-Only Lab
ANALYSIS_ONLY=true
LIVE_TRADING=false

# Data Provider: mock or mt5
DATA_PROVIDER=mock
# Mock Scenario: no_setup, high_sweep, low_sweep
MOCK_SCENARIO=no_setup
# Safety: block if spread or volatility is unavailable
BLOCK_IF_DATA_MISSING=true

# MetaTrader 5 Credentials (Optional, only used if DATA_PROVIDER=mt5)
# MT5_LOGIN=123456
# MT5_PASSWORD=your_password
# MT5_SERVER=your_server

SYMBOL=EURUSD
TIMEFRAME=TIMEFRAME_M5
MAX_RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_TRADES_PER_DAY=5
SPREAD_LIMIT=20
VOLATILITY_LIMIT=0.005
CONTEXT_SCORE_MIN=60
ENTRY_SCORE_MIN=65
NO_CHASE_MAX_ATR=0.6
CONTEXT_LOOKBACK=20
